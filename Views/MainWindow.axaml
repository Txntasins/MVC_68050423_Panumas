<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FriendsForeverChangeRequest.Views.MainWindow"
        Title="Role Change Request Management System - Friends Forever Co., Ltd."
        Width="960" Height="640"
        MinWidth="760" MinHeight="520">

  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Top"
               Text="Role Change Request Management System - Friends Forever Co., Ltd."
               FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8"
            Background="#1E1E1E" CornerRadius="4">
      <TextBlock Name="StatusText" Text="Ready" Foreground="White" TextWrapping="Wrap" />
    </Border>

    <TabControl>

      <TabItem Header="Members &amp; Requests">
        <Grid RowDefinitions="Auto,*,Auto,*" ColumnDefinitions="*" Margin="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Name="RefreshMembersButton" Content="Reload Data" Click="OnRefreshMembersClicked" />
          </StackPanel>

          <DataGrid Grid.Row="1" Name="MembersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="220" Margin="0,0,0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="2" Text="Role Change Requests" FontWeight="Bold" Margin="0,0,0,6" />

          <DataGrid Grid.Row="3" Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Request" Binding="{Binding Id}" Width="70" />
              <DataGridTextColumn Header="Requester -&gt; Target" Binding="{Binding Who}" Width="160" />
              <DataGridTextColumn Header="New Role" Binding="{Binding NewRole}" Width="120" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Create Request">
        <StackPanel Margin="8" Width="360" HorizontalAlignment="Left" Spacing="10">
          <StackPanel>
            <TextBlock Text="Requester ID (e.g. M01)" />
            <TextBox Name="CreateRequesterIdBox" Watermark="M01" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Target Member ID (e.g. M02)" />
            <TextBox Name="CreateTargetIdBox" Watermark="M02" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="New Role" />
            <ComboBox Name="CreateNewRoleBox" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="PRODUCER" />
              <ComboBoxItem Content="FINANCE" />
              <ComboBoxItem Content="EDITOR" />
              <ComboBoxItem Content="CREATOR" />
            </ComboBox>
          </StackPanel>
          <Button Name="CreateRequestButton" Content="Create Request" Click="OnCreateRequestClicked"
                   HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Submit Decision">
        <StackPanel Margin="8" Width="420" HorizontalAlignment="Left" Spacing="10">
          <StackPanel>
            <TextBlock Text="Request ID (e.g. C01)" />
            <TextBox Name="DecisionRequestIdBox" Watermark="C01" />
          </StackPanel>

          <Button Name="ShowEligibleButton" Content="Show Eligible Deciders"
                  Click="OnShowEligibleClicked" HorizontalAlignment="Left" />

          <ListBox Name="EligibleList" Height="120" />

          <StackPanel>
            <TextBlock Text="Deciding Member ID" />
            <TextBox Name="DecisionMemberIdBox" Watermark="M03" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Decision" />
            <ComboBox Name="DecisionResultBox" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="APPROVE" />
              <ComboBoxItem Content="REJECT" />
            </ComboBox>
          </StackPanel>
          <Button Name="SubmitDecisionButton" Content="Submit Decision" Click="OnSubmitDecisionClicked"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Cancel Request">
        <StackPanel Margin="8" Width="360" HorizontalAlignment="Left" Spacing="10">
          <StackPanel>
            <TextBlock Text="Request ID to Cancel" />
            <TextBox Name="CancelRequestIdBox" Watermark="C01" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Requester ID (confirms who is cancelling)" />
            <TextBox Name="CancelActorIdBox" Watermark="M01" />
          </StackPanel>
          <Button Name="CancelRequestButton" Content="Cancel Request" Click="OnCancelRequestClicked"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Summary">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Name="RefreshSummaryButton" Content="Show / Refresh Summary"
                  Click="OnRefreshSummaryClicked" HorizontalAlignment="Left" Margin="0,0,0,10" />
          <ScrollViewer>
            <StackPanel Spacing="16">
              <StackPanel>
                <TextBlock Text="Requests by Status" FontWeight="Bold" FontSize="14" />
                <ItemsControl Name="StatusSummaryList" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Current Member Roles" FontWeight="Bold" FontSize="14" />
                <DataGrid Name="MemberRolesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
